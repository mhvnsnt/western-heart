{
 "character_mapping_format": {
  "description": "Same universal format as eye-library (see CUSTOMIZATION-LIBRARY-LAYOUT.md). To make every part work on a NEW character: add one entry here naming that character's eye/decal textures (texture_part) \u2014 mesh_parts attach at bone sockets and need no mapping, only optional per-character offsets.",
  "mesh_part_fields": {
   "bone_aliases": [
    "bone",
    "names"
   ],
   "character": "character id (optional)",
   "offset": [
    0,
    0,
    0
   ],
   "rotation": [
    0,
    0,
    0
   ],
   "scale": 1.0,
   "socket": "suite socket name"
  },
  "texture_part_fields": {
   "character": "character id",
   "material": "material name",
   "rect": "pixel rect to composite into (full replace if omitted)",
   "replaces_texture": "texture name in that character's GLB",
   "texture_size": [
    128,
    128
   ]
  }
 },
 "character_mappings": {
  "pantera": {
   "character": "Pantera (Western Heart roster/pantera, King-based)",
   "decal_logo": {
