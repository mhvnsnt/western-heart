{
 "character_mapping_format": {
  "description": "Same universal format as eye-library (see CUSTOMIZATION-LIBRARY-LAYOUT.md). To make every part work on a NEW character: add one entry here naming that character's eye/decal textures (texture_part) — mesh_parts attach at bone sockets and need no mapping, only optional per-character offsets.",
  "mesh_part_fields": {
   "bone_aliases": [
    "bone",
    "names"
   ],
   "character": "character id (optional)",
   "offset": [
    0,
    0,
    0
   ],
   "rotation": [
    0,
    0,
    0
   ],
   "scale": 1.0,
   "socket": "suite socket name"
  },
  "texture_part_fields": {
   "character": "character id",
   "material": "material name",
   "rect": "pixel rect to composite into (full replace if omitted)",
   "replaces_texture": "texture name in that character's GLB",
   "texture_size": [
    128,
    128
   ]
  }
 },
 "character_mappings": {
  "pantera": {
   "character": "Pantera (Western Heart roster/pantera, King-based)",
   "decal_logo": {
    "material": "Modelthighs_Material029",
    "texture": "King_PantsLower_D",
    "texture_size": [
     512,
     512
    ]
   },
   "eye": {
    "material": "Modeleyes_Material003",
    "replaces_texture": "King_Eye_D",
    "texture_size": [
     128,
     128
    ]
   },
   "pants": {
    "replaces_texture": "King_PantsUpper_D",
    "texture_size": [
     512,
     256
    ]
   },
   "tights": {
    "replaces_texture": "King_PantsLower_D",
    "texture_size": [
     512,
     512
    ]
   }
  },
  "lili": {
   "character": "Lili (Western Heart roster/lili)",
   "notes": "Noir Gala attire: 9 dress textures + yellow tiger eyes. Originals saved as swap options."
  },
  "zafina": {
   "character": "Zafina (Western Heart roster/zafina)",
   "notes": "Golden Pharaoh attire: gold butterfly top + yellow tiger eyes. Originals saved as swap options."
  }
 },
 "created": "2026-10-18",
 "how_to_use": [
  "1. The suite (packages/creation-suite/src/parts.js) loads this registry.",
  "2. Texture parts: resolveEntry(entry, charId) merges the character's mapping; swapTexture() replaces the texture live — swap back restores the original (nothing overwritten).",
  "3. Mesh parts: attachPart() routes to attach() at the registry socket (bone aliases shared across rigs) with optional fit=headHeight auto-scale.",
  "4. Web UI (customization/create-fighter/): Catalog gains the eyes / decals / masks categories sourced from the same entries."
 ],
 "libraries": {
  "decal-library-pantera": {
   "kind": "decal_logo | tights | pants",
   "manifest": "customization/decal-library/pantera/MANIFEST.json",
   "note": "Parameterized logo/tights/pants texture swaps with canonical placements.",
   "part_class": "texture_part",
