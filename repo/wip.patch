   ms._slots = slots;
   const motions = [];
+  // Source rank of the move a notation binds (lane B 2026-10-24, docs/input/INPUT-RESOLVER-V2.md
+  // "Duplicate physical inputs"): T8 0 > T7 1 > WH/custom 2 > T3 3. When two spellings are the same
+  // physical input (qcf+1 vs n,d,d/f,f+1), the fighter's T7/T8 move wins over a merged T3 row.
+  const srcRank = (n) => {
+    const mv = ms.moves[slots[n]] || {}, src = String(mv.merge_source || '');
+    if (mv.t8_id || mv.t8_source || /^t8/.test(src)) return 0;
+    if (mv.t7_source || mv.t7_move_id || /^t7/.test(src)) return 1;
+    return mv.t3_row == null && !/^t3/.test(src) ? 2 : 3;
+  };
+  const plenOf = (dirs) => dirs.filter((d, i, a) => !(d === 'n' && a[i - 1] === a[i + 1])).length; // 'f,n,f' = 'f,F'
   for (const n of Object.keys(slots)) {
