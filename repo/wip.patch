+  motions.sort((a, b) => (b.plen - a.plen) || (a.rank - b.rank));
   ms._motions = motions;
   // v2: every proper prefix of a string ('d/f+2,1' of 'd/f+2,1,3,2') — lets a string whose
   // intermediate steps are not standalone moves (chain throws, long strings) still be typed.
@@ -290,6 +303,73 @@ function _prepare(ms) {
     for (const j of cuts) pre.add(n.slice(0, j));
   }
   ms._strPrefixes = pre;
+  // STRING TREE (lane B, 2026-10-24): base notation -> the notations one press further down the
+  // string ('1' -> {'1,2','1,4'}, '1,2' -> {'1,2,1'} ...) — the same tree T8's `parent` chains
+  // describe, rebuilt from the comma notation every moveset already uses. A step boundary is a
+  // separator right after a button ('f,F+2,1' cuts after 'f,F+2', never inside the motion).
+  const kids = new Map();
+  for (const n of Object.keys(slots)) {
+    if (MERGE_KEY.test(n)) continue; // '1~t8.bryan', 'b+3,2~t7.bryan.2': merge-source keys, not inputs
+    let prev = null;
+    for (let j = 0; j <= n.length; j++) {
+      if (j < n.length && !',~:'.includes(n[j])) continue;
+      const head = n.slice(0, j);
+      if (j < n.length && !STEP_END.test(head)) continue;
+      if (prev !== null) {
+        if (!kids.has(prev)) kids.set(prev, new Set());
+        kids.get(prev).add(head);
+      }
+      prev = head;
+    }
+  }
+  ms._strKids = kids;
+  // Same physical base under two spellings ('qcb+1+3' / 'd,d/b,b+1+3', 'd/f,d/f+1' / 'n,d/f,n,d/f+1'):
+  // a string written under one spelling continues from the other.
+  const alias = new Map();
+  for (const b of kids.keys()) { const k = physKey(b); if (!alias.has(k)) alias.set(k, []); alias.get(k).push(b); }
+  ms._physAlias = alias;
+  // Motion OPENERS: a motion that only starts a string ('R.f,n,d,d/f+4' of 'R.f,n,d,d/f+4,3+4')
+  // is matched like a motion and opens the string path (V2 `opener`).
+  for (const b of kids.keys()) {
+    if (b in slots) continue;
+    const m = parseMotion(b);
+    if (m) motions.push({ n: b, ...m, rank: 3, opener: true, plen: plenOf(m.dirs) });
+  }
+  motions.sort((a, b) => (b.plen - a.plen) || (a.rank - b.rank));
+  // Combined state prefixes the data uses ('R.SEN.1+2' rage in SEN stance, 'H.RFS.f+4' Soul Urge in
+  // RFS, 'NSS.FC.D/F+1'): resolved when every token is active, most tokens first.
+  const combos = new Map();
+  for (const n of Object.keys(slots)) {
+    const m = STATE_PREFIX.exec(n);
+    if (!m || MERGE_KEY.test(n)) continue;
+    const toks = m[1].split('.').filter(Boolean);
+    if (toks.length > 1 && !combos.has(m[1])) combos.set(m[1], toks);
+  }
+  ms._combos = [...combos].map(([p, toks]) => ({ p, toks })).sort((a, b) => b.toks.length - a.toks.length);
+}
+const STEP_END = /(?:^|[+.,~:])[1-4](?:\+[1-4])*\*?$/;
+const MERGE_KEY = /~[a-z][a-z0-9_-]*\./;
+const TILDE_FRAMES = 4; // '~' (immediately): a string step pressed < 4 frames (67 ms) of game time after the previous press
+/** One spelling per physical input: qcf/qcb/hcf/hcb expanded, leading n dropped, 'f,n,f' = 'f,f',
+    'n+1' = '1' (prefixes and held capitals kept). */
+function physKey(n) {
+  const { prefix, body } = splitNotation(n);
+  // separators are timing marks only (',' '~' ':' read alike; just-frame 'd/f:1' = 'd/f+1'); 'N' = 'n';
+  // a lone n before a button is just "neutral" ('d+4,n,4' = 'd+4,4', 'd+2~n~1' = 'd+2,1')
+  let t = body.replace(/([a-zA-Z/]):(?=[1-4])/g, '$1+').replace(/[~:]/g, ',').split(',').map(x => (x === 'N' ? 'n' : x))
+    .filter((x, i, a) => !(x === 'n' && i > 0 && /^[1-4]/.test(a[i + 1] || ''))).flatMap(x => {
+      const m = /^(qcf|qcb|hcf|hcb)(\+.*)?$/.exec(x);
+      if (!m) return [x];
+      const d = MOTION_DIRS[m[1]];
+      return [...d.slice(0, -1), d[d.length - 1] + (m[2] || '')];
+    }).map((x, i) => (i ? x.replace(/^[A-Z][A-Z0-9_]*\./, '') : x).replace(/^n\+(?=[1-4])/, '')); // 'WS.2,NSS.1' = 'WS.2,1'
+  while (t.length > 1 && t[0] === 'n') t.shift();
+  const out = [], dirOf = (x) => String(x || '').split('+')[0];
+  for (let i = 0; i < t.length; i++) {
+    if (t[i] === 'n' && out.length && dirOf(out[out.length - 1]) === dirOf(t[i + 1])) continue;
+    out.push(t[i]);
+  }
+  return prefix + out.join(',');
 }
 
