-    if (m) motions.push({ n, ...m });
+    if (MERGE_KEY.test(n)) continue; // merge-source keys ('1~t3.king') are never inputs
+    // just-frame 'f,n,d/f:1' (EWGF spelling) is pressed like 'f,n,d/f+1' (no JF timing in WH)
+    const m = parseMotion(n) || (/[a-zA-Z/]:[1-4]/.test(n) ? parseMotion(n.replace(/([a-zA-Z/]):(?=[1-4])/g, '$1+')) : null);
