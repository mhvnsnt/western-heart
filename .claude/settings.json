{
  "hooks": {
    "SessionStart": [
      { "matcher": "startup|resume|compact", "hooks": [
        { "type": "command", "command": "bash \"${CLAUDE_PROJECT_DIR}/tools/agent/restore.sh\"", "timeout": 60 },
        { "type": "command", "command": "bash \"${CLAUDE_PROJECT_DIR}/tools/agent/session-start.sh\"", "timeout": 20 } ] }
    ],
    "PostToolUse": [
      { "matcher": "Write|Edit|MultiEdit|NotebookEdit", "hooks": [
        { "type": "command", "command": "bash \"${CLAUDE_PROJECT_DIR}/tools/agent/autosave.sh\"", "async": true, "timeout": 120 },
        { "type": "command", "command": "bash \"${CLAUDE_PROJECT_DIR}/tools/agent/checkpoint.sh\"", "async": true, "timeout": 180 } ] }
    ],
    "Stop": [
      { "hooks": [
        { "type": "command", "command": "bash \"${CLAUDE_PROJECT_DIR}/tools/agent/autosave.sh\"", "async": true, "timeout": 120 },
        { "type": "command", "command": "bash \"${CLAUDE_PROJECT_DIR}/tools/agent/checkpoint.sh\"", "async": true, "timeout": 180 } ] }
    ],
    "StopFailure": [
      { "hooks": [
        { "type": "command", "command": "bash \"${CLAUDE_PROJECT_DIR}/tools/agent/autosave.sh\"", "timeout": 60 },
        { "type": "command", "command": "bash \"${CLAUDE_PROJECT_DIR}/tools/agent/checkpoint.sh\"", "timeout": 180 } ] }
    ],
    "PreCompact": [
      { "hooks": [
        { "type": "command", "command": "bash \"${CLAUDE_PROJECT_DIR}/tools/agent/autosave.sh\"", "timeout": 60 },
        { "type": "command", "command": "bash \"${CLAUDE_PROJECT_DIR}/tools/agent/checkpoint.sh\"", "timeout": 180 } ] }
    ],
    "SessionEnd": [
      { "hooks": [
        { "type": "command", "command": "bash \"${CLAUDE_PROJECT_DIR}/tools/agent/autosave.sh\"", "timeout": 60 },
        { "type": "command", "command": "bash \"${CLAUDE_PROJECT_DIR}/tools/agent/checkpoint.sh\"", "timeout": 180 } ] }
    ]
  }
}
