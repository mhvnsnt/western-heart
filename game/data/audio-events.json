  "musicPools": {
    "default": {
      "tracks": [
        {
          "layers": [
            {
              "bank": "stage_default_base.opus",
              "baseGain": 1.0,
              "name": "base"
            },
            {
              "bank": "stage_default_drums.opus",
              "baseGain": 0.0,
              "name": "drums"
            },
            {
              "bank": "stage_default_lead.opus",
              "baseGain": 0.0,
              "name": "lead"
            }
          ]
        }
      ]
    },
    "note": "One pool per stage. Rotation = random track pick at round start + re-pick at next bar boundary between rounds. All layers of a track start at the same ctx time so they stay in sync; layer gains are RTPC-driven (below). Keep every layer the same length/BPM or the crossfade drifts."
  },
  "note_on_pantera_bank": "Sampler MP3s in ~/workspace/king-mods/ are CONCATENATED samplers, not split clips. The manifest in king-mods/pantera-sounds-manifest.md gives per-clip durations for Set B (Tekken 2 grunts, 26 clips, owner-preferred 2026-10-24). Before this JSON is usable, split the sampler into 26 files OR add cue:[start,dur] ranges computed by cumulatively summing Set B durations in file order. Do NOT invent cue offsets \u2014 compute them from the manifest. Set A (classic) is the fallback bank; Set C is the single T8 death scream (2.529s). Clip labels (greeting/growl/roar) are NOT in the bank data \u2014 identify by position number only.",
  "rtpcCurves": {
    "intensity": {
      "base": {
        "inMax": 1.0,
        "inMin": 0.0,
        "outMax": 0.85,
        "outMin": 1.0
      },
      "drums": {
        "inMax": 0.7,
        "inMin": 0.3,
        "outMax": 1.0,
        "outMin": 0.0
      },
      "lead": {
        "inMax": 1.0,
        "inMin": 0.6,
        "outMax": 1.0,
        "outMin": 0.0
      }
    },
    "note_intensity_drivers": "intensity = clamp(0.35*comboHeat + 0.35*healthDeficit + 0.30*roundTimerPressure), each 0..1. comboHeat decays over ~3s without a hit; healthDeficit = 1 - (ownHP/maxHP) of the LOSING fighter; roundTimerPressure rises in the last 15s. Recompute once per frame from game state \u2014 cheap, no audio-thread work."
  },
